<% answer = translated_attribute(project.answer) %>

<% if answer.present? && strip_tags(answer).strip.present? %>
  <div class="banner bg-silver-medium-light">
    <div class="banner__content">
      <h2 class="h3"><%= t(".title") %></h2>

      <%= decidim_sanitize_editor_admin(answer) %>
    </div>
  </div>
<% end %>
